# Plantilla de configuracion. Copiela a .env antes de levantar el proyecto:
#   cp .env.example .env
#
# ADVERTENCIA: estas credenciales son solo para desarrollo local.
# En un despliegue real deben reemplazarse por valores generados
# aleatoriamente y gestionarse con un almacen de secretos.

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iadb
DB_USER=app_ia
DB_PASSWORD=claveApp456
DB_ADMIN_PASSWORD=claveAdmin123

# --- Motor de inferencia ---
OLLAMA_URL=http://localhost:11434/api/generate

# Modelo segun el perfil de hardware (Anexo A de la guia):
#   Perfil A (16 GB o mas) -> qwen2.5-coder:1.5b
#   Perfil B (8 GB)        -> qwen2.5:0.5b
#   Perfil C (4 GB)        -> gemma3:270m
MODELO_OLLAMA=qwen2.5-coder:1.5b

# Motor usado cuando la peticion no especifica uno: eco u ollama
MOTOR_POR_DEFECTO=ollama
